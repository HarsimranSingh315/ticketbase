# Copy this file to .env and adjust for your environment.
# Nothing here is required - every setting has a safe local default
# (see app/config.py). This file exists so you know what CAN be set.

# --- Database ---
# Default: local SQLite file, zero setup.
# For Postgres (after `docker-compose up -d`):
# DATABASE_URL=postgresql://ticketbase:ticketbase@localhost:5432/ticketbase
DATABASE_URL=sqlite:///./ticketbase.db

# --- API authentication ---
# Leave blank to disable auth (local dev / running the test suite).
# Set to a real secret to require an `X-API-Key` header on all
# POST/PATCH requests. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# --- SupportRAG tuning ---
RAG_TOP_K=3
RAG_CONFIDENCE_THRESHOLD=0.25

# --- Optional LLM-drafted responses ---
# Leave LLM_API_KEY blank to disable (default) - the deterministic
# template in app/supportrag.py is used instead, with no cost and no
# external calls. Get a free key (no credit card) at https://console.groq.com
# The LLM only rewrites the wording of an already-retrieved KB article -
# it never picks the category, and it's never called when retrieval
# itself wasn't confident enough (see app/llm.py). Any failure (bad
# key, rate limit, decommissioned model) falls back to the template
# automatically. LLM_API_BASE/LLM_MODEL are OpenAI-compatible, so
# another provider (OpenRouter, Cerebras, etc.) is a config change only.
LLM_API_KEY=
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=8.0

# --- Rate limiting ---
SUGGEST_RATE_LIMIT=20/minute
LOGIN_RATE_LIMIT=10/minute

# --- Agent auth (Milestone 1) ---
# SECRET_KEY signs CSRF tokens. Leave blank for local dev (a random one
# is generated per-process, logged as a warning) - set a real value for
# anything beyond a single local process. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
SESSION_TTL_HOURS=12
INVITE_TTL_HOURS=72
# Set true once served over real HTTPS - false is correct for local
# http:// dev, but a session cookie sent over plain HTTP in production
# can be intercepted.
SESSION_COOKIE_SECURE=false

# Account creation is invite-only - something has to create the first
# admin. If BOTH of these are set and no users exist yet, that admin
# is created automatically at startup. Unset both after first use.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Logging ---
LOG_LEVEL=INFO

# --- Outbound email (Milestone 2) ---
# Leave RESEND_API_KEY blank to use the local sink adapter (default) -
# "sent" mail is durably recorded in the local_sink_emails table
# instead of any real network call, with no cost and no external
# dependency. Get a free key (no credit card) at https://resend.com to
# switch to real delivery via the Resend adapter (app/mail.py).
RESEND_API_KEY=
MAIL_FROM_ADDRESS=support@ticketbase.local
MAIL_FROM_NAME=TicketBase Support

# --- Outbox worker tuning (see worker.py) ---
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_POLL_INTERVAL_SECONDS=2.0

# --- Telephony (Milestone 3) ---
# Required for /webhooks/twilio/* to accept anything - with this blank
# (the default), every webhook request is rejected regardless of any
# signature it carries (fails closed, not open). Get your Auth Token
# from the Twilio Console (https://console.twilio.com) after creating
# a free trial account, then point your Twilio phone number's webhook
# URLs at https://your-public-url/webhooks/twilio/voice and .../status.
# Note: a real end-to-end test (an actual phone call reaching this app)
# requires this app to be deployed somewhere with a public URL - it
# cannot be tested from a purely local/sandboxed environment, since
# Twilio's servers need to reach yours, not the other way around.
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=
# Outbound calling (app/telephony.py's get_call_adapter): leave
# TWILIO_ACCOUNT_SID blank to use the local sink call adapter (records
# the attempt as a real Call row, places no real call - zero cost, no
# Twilio account needed). Set BOTH TWILIO_ACCOUNT_SID and
# TWILIO_AUTH_TOKEN to switch to real outbound calls via Twilio's REST
# API - but a real call ALSO needs PUBLIC_BASE_URL below, since Twilio
# fetches TwiML instructions from that URL the moment the call
# connects; without it, a real call attempt fails cleanly with "No
# twiml_url configured" rather than silently falling back.
PUBLIC_BASE_URL=

# --- SLA timers (see sla_check.py) ---
# Deadline = ticket created_at + the hours for its priority. Simple by
# design - one clock per priority, not business-hours-aware.
SLA_HIGH_PRIORITY_HOURS=4.0
SLA_MEDIUM_PRIORITY_HOURS=24.0
SLA_LOW_PRIORITY_HOURS=72.0
SLA_CHECK_POLL_INTERVAL_SECONDS=60.0
