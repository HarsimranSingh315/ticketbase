# Copy this file to .env and adjust for your environment.
# Nothing here is required - every setting has a safe local default
# (see app/config.py). This file exists so you know what CAN be set.

# --- Database ---
# Default: local SQLite file, zero setup.
# For Postgres (after `docker-compose up -d`):
# DATABASE_URL=postgresql://ticketbase:ticketbase@localhost:5432/ticketbase
DATABASE_URL=sqlite:///./ticketbase.db

# --- API authentication ---
# Leave blank to disable auth (local dev / running the test suite).
# Set to a real secret to require an `X-API-Key` header on all
# POST/PATCH requests. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# --- SupportRAG tuning ---
RAG_TOP_K=3
RAG_CONFIDENCE_THRESHOLD=0.25

# --- Rate limiting ---
SUGGEST_RATE_LIMIT=20/minute

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Logging ---
LOG_LEVEL=INFO
