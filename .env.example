# Copy this file to .env and adjust for your environment.
# Nothing here is required - every setting has a safe local default
# (see app/config.py). This file exists so you know what CAN be set.

# --- Database ---
# Default: local SQLite file, zero setup.
# For Postgres (after `docker-compose up -d`):
# DATABASE_URL=postgresql://ticketbase:ticketbase@localhost:5432/ticketbase
DATABASE_URL=sqlite:///./ticketbase.db

# --- API authentication ---
# Leave blank to disable auth (local dev / running the test suite).
# Set to a real secret to require an `X-API-Key` header on all
# POST/PATCH requests. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# --- SupportRAG tuning ---
RAG_TOP_K=3
RAG_CONFIDENCE_THRESHOLD=0.25

# --- Optional LLM-drafted responses ---
# Leave LLM_API_KEY blank to disable (default) - the deterministic
# template in app/supportrag.py is used instead, with no cost and no
# external calls. Get a free key (no credit card) at https://console.groq.com
# The LLM only rewrites the wording of an already-retrieved KB article -
# it never picks the category, and it's never called when retrieval
# itself wasn't confident enough (see app/llm.py). Any failure (bad
# key, rate limit, decommissioned model) falls back to the template
# automatically. LLM_API_BASE/LLM_MODEL are OpenAI-compatible, so
# another provider (OpenRouter, Cerebras, etc.) is a config change only.
LLM_API_KEY=
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=8.0

# --- Rate limiting ---
SUGGEST_RATE_LIMIT=20/minute

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Logging ---
LOG_LEVEL=INFO
